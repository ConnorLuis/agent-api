# Copy this file to .env and adjust local values as needed.
# Mock/deterministic paths remain the default so tests do not require external
# Ollama, Neo4j, or MCP services.

# Application
APP_NAME=agent-api
APP_ENV=dev
LLM_PROVIDER=mock

# Optional local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0

# Optional Neo4j GraphRAG backend
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Main Agent MCP gateway. Keep disabled unless the target server is ready.
AGENT_API_MAIN_AGENT_MCP_ENABLED=false
AGENT_API_MAIN_AGENT_MCP_FALLBACK_ENABLED=true
AGENT_API_MAIN_AGENT_MCP_SERVER_ID=agent-api-local
AGENT_API_MAIN_AGENT_MCP_MODE=local_wrapper

# Optional local semantic embedding validation
# Install sentence-transformers separately before running the real-model
# validation script, then set an accessible local model path or model ID.
# SEMANTIC_EMBEDDING_MODEL=/absolute/path/to/embedding-model
SEMANTIC_EMBEDDING_DIM=768

# Optional Day41 evaluation inputs and outputs
# DAY41_SEMANTIC_EVAL_INPUT=reports/day41/semantic_eval.json
# DAY41_SEMANTIC_REVIEW_OUTPUT=reports/day41/semantic_review.md
# DAY41_SEMANTIC_EVAL_OUTPUT=reports/day41/semantic_extended_eval.json
